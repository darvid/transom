amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

steps {
  ["swiftformat"] {
    glob = List("**/*.swift")
    check = new CommandSpec {
      command = new Command {
        argv = List("swiftformat", "--lint", "--cache", "ignore", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("swiftformat", "--cache", "ignore", "{{files}}")
      }
      effect = "write"
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  ["actionlint"] = Builtins.actionlint
  ["plist"] {
    glob = List("**/*.plist")
    check = new CommandSpec {
      command = new Command { argv = List("plutil", "-lint", "{{files}}") }
      effect = "read"
    }
  }
  ["rumdl"] = (Builtins.rumdl) {
    exclude = List("CHANGELOG.md")
  }
  ["typos"] = (Builtins.typos) {
    glob = List("**/*.md", "**/*.markdown")
    exclude = List("CHANGELOG.md")
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
  }
  ["fix"] {
    stage = false
    stash = "none"
  }
}
